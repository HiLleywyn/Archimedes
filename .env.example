# ──────────────────────────────────────────────────────────────────────────────
# Archimedes -- standalone AI chat bot configuration
#
# Copy this file to .env and fill in the values. Only DISCORD_TOKEN,
# DATABASE_URL and OPENROUTER_API_KEY are strictly required to boot.
# ──────────────────────────────────────────────────────────────────────────────

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
# Command prefix for .ai and .arch. Single character recommended.
PREFIX=.
# Optional: numeric Discord user id of the bot owner.
OWNER_ID=

# ── Storage ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Required -- holds all conversation history,
# memory, traits, facts and settings.
DATABASE_URL=postgresql://user:pass@localhost:5432/archimedes
# Redis connection string. Optional -- used for short-term conversation
# buffers. The bot runs without it (short-term memory falls back to Postgres).
REDIS_URL=

# ── Model provider (OpenRouter) ───────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default chat model. Any OpenRouter slug works.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional per-category model overrides (blank = use OPENROUTER_MODEL).
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_TOOLS_MODEL=
OPENROUTER_REASON_MODEL=
# Sent as HTTP-Referer / X-Title on OpenRouter requests.
OPENROUTER_REFERER=https://github.com
OPENROUTER_TITLE=Archimedes

# ── Optional local backend (Ollama) ───────────────────────────────────────────
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
# Which backend the chat loop uses: openrouter | ollama
CHAT_BACKEND=openrouter

# ── Web search tool ───────────────────────────────────────────────────────────
# Backend the data.web_search tool uses: ddg (no key) | brave (needs key)
SEARCH_BACKEND=ddg
BRAVE_SEARCH_API_KEY=

# ── AI behaviour ──────────────────────────────────────────────────────────────
# Hard timeout per reply, seconds.
AI_REPLY_TIMEOUT_S=90
# Concurrent in-flight model requests.
AI_QUEUE_CAP=6
# Per-user message quota and rolling window (seconds).
AI_QUOTA_LIMIT=25
AI_QUOTA_WINDOW=3600
# Minimum seconds between replies for one user.
AI_COOLDOWN_S=4
# Log ambient channel chatter as episodes when a channel is opted in.
ARCHIMEDES_PASSIVE_LEARNING=false
# Let the bot occasionally chime in unprompted in allowlisted channels.
AMBIENT_REPLIES=false

# ── Memory ────────────────────────────────────────────────────────────────────
# Hours before a stored user memory is considered stale and refreshed.
MEMORY_REFRESH_HOURS=4
# Short-term conversation turns kept in Redis.
SHORT_TERM_TURNS=12
SHORT_TERM_TTL_S=86400

# ── Misc ──────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
