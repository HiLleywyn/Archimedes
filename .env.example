# ──────────────────────────────────────────────────────────────────────────────
# Archimedes -- standalone AI chat bot configuration
#
# Copy this file to .env and fill in the values. Only DISCORD_TOKEN,
# DATABASE_URL and OPENROUTER_API_KEY are strictly required to boot.
# ──────────────────────────────────────────────────────────────────────────────

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
# Command prefix for .ai and .arch. Single character recommended.
PREFIX=.
# Optional: numeric Discord user id of the bot owner.
OWNER_ID=

# ── Storage ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Required -- holds all conversation history,
# memory, traits, facts and settings.
DATABASE_URL=postgresql://user:pass@localhost:5432/archimedes
# Redis connection string. Optional -- used for short-term conversation
# buffers. The bot runs without it (short-term memory falls back to Postgres).
REDIS_URL=

# ── Model provider (OpenRouter) ───────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default chat model. Any OpenRouter slug works.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional per-category model overrides (blank = use OPENROUTER_MODEL).
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_TOOLS_MODEL=
OPENROUTER_REASON_MODEL=
# Image and video generation models. Always run on OpenRouter, whatever
# CHAT_BACKEND is. Retunable per server at runtime with
# `.ai model set image <slug>` / `.ai model set video <slug>`.
OPENROUTER_IMAGE_MODEL=x-ai/grok-imagine-image-quality
OPENROUTER_VIDEO_MODEL=x-ai/grok-imagine-video
# Sent as HTTP-Referer / X-Title on OpenRouter requests.
OPENROUTER_REFERER=https://github.com
OPENROUTER_TITLE=Archimedes

# ── Optional local backend (Ollama) ───────────────────────────────────────────
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
# Which backend the chat loop uses: openrouter | ollama
CHAT_BACKEND=openrouter

# ── Web search tool ───────────────────────────────────────────────────────────
# Backend the data.web_search tool uses: ddg (no key) | brave (needs key)
SEARCH_BACKEND=ddg
BRAVE_SEARCH_API_KEY=

# ── AI behaviour ──────────────────────────────────────────────────────────────
# Hard timeout per reply, seconds.
AI_REPLY_TIMEOUT_S=90
# Concurrent in-flight model requests.
AI_QUEUE_CAP=6
# Per-user message quota and rolling window (seconds).
AI_QUOTA_LIMIT=25
AI_QUOTA_WINDOW=3600
# Minimum seconds between replies for one user.
AI_COOLDOWN_S=4
# Log ambient channel chatter as episodes when a channel is opted in.
ARCHIMEDES_PASSIVE_LEARNING=false
# Let the bot occasionally chime in unprompted in allowlisted channels.
AMBIENT_REPLIES=false

# ── Agent SDK sidecar ─────────────────────────────────────────────────────────
# The multi-step tool-calling loop runs in a Node sidecar (agent-sidecar/) that
# embeds the OpenRouter Agent SDK. When the sidecar is unreachable the bot
# falls back to its in-process loop, so this is safe to leave on.
AGENT_SIDECAR_ENABLED=true
# External sidecar WebSocket endpoint. Leave blank to autostart a local one
# (needs a node runtime and a built agent-sidecar/dist; the Docker image
# bundles both).
AGENT_SIDECAR_URL=
# Port for the autostarted local sidecar.
AGENT_SIDECAR_PORT=8770
# Stop conditions for the agent loop: a hard ceiling on model steps per turn,
# and an optional cost cap in US dollars (0 disables the cost cap).
AGENT_MAX_STEPS=4
AGENT_MAX_COST=0
# Provider routing and resilience for the sidecar (all optional, all blank by
# default -- a blank value changes nothing). AGENT_FALLBACK_MODELS is a
# comma-separated list of models the sidecar tries, in order, after the
# primary one. AGENT_PROVIDER_ORDER is a comma-separated list of provider
# slugs to prefer; AGENT_PROVIDER_ALLOW_FALLBACKS keeps OpenRouter free to use
# other providers when those are unavailable. AGENT_SERVER_TOOLS is a
# comma-separated list of OpenRouter server-side tool types to enable, e.g.
# "openrouter:datetime" (they run on OpenRouter, not bridged to the bot).
AGENT_FALLBACK_MODELS=
AGENT_PROVIDER_ORDER=
AGENT_PROVIDER_ALLOW_FALLBACKS=true
AGENT_SERVER_TOOLS=
# Tool-call approval. A gated tool call posts an Approve / Reject prompt in
# the channel and waits for the person who asked; a rejected call never runs
# and the model is told it was declined. AGENT_APPROVAL_TOOLS is a
# comma-separated list of tool names to gate (e.g.
# "files.write,files.delete"); AGENT_APPROVAL_RISKS a comma-separated list of
# risk tiers to gate (read, safe, mutate). Both default empty, which leaves
# approval off and changes nothing. AGENT_APPROVAL_TIMEOUT_S bounds the wait
# for a decision; keep it well below AI_REPLY_TIMEOUT_S, since the wait counts
# against the turn.
AGENT_APPROVAL_TOOLS=
AGENT_APPROVAL_RISKS=
AGENT_APPROVAL_TIMEOUT_S=45

# ── Memory ────────────────────────────────────────────────────────────────────
# Hours before a stored user memory is considered stale and refreshed.
MEMORY_REFRESH_HOURS=4
# Short-term conversation turns kept in Redis.
SHORT_TERM_TURNS=12
SHORT_TERM_TTL_S=86400

# ── Lua plugins ───────────────────────────────────────────────────────────────
# Turn the Lua plugin system on or off entirely.
PLUGINS_ENABLED=true
# The GitHub repository the plugin marketplace reads from.
PLUGIN_REGISTRY_REPO=hilleywyn/archimedes-plugins
# The branch, tag or commit of that repository to install plugins from.
PLUGIN_REGISTRY_REF=main
# Optional GitHub token. Only needed when the marketplace repository is
# private, or to lift the unauthenticated API rate limit.
GITHUB_TOKEN=

# ── Plugin HTTP client ────────────────────────────────────────────────────────
# The guarded outbound HTTP surface handed to Lua plugins as arch.http. Every
# request is SSRF-checked. These are hard ceilings: a plugin may ask for less,
# never more. (The Dockerfile bakes these same defaults into the image.)
PLUGIN_HTTP_ENABLED=true
PLUGIN_HTTP_TIMEOUT_S=20
PLUGIN_HTTP_MAX_BYTES=1048576
PLUGIN_HTTP_MAX_REDIRECTS=3
# Leave this off. On is an escape hatch for self-hosted operators who
# deliberately want plugins to reach a private network.
PLUGIN_HTTP_ALLOW_PRIVATE=false

# ── Plugin configuration ──────────────────────────────────────────────────────
# Per-plugin operator config. A PLUGIN_<ID>_<KEY> variable is exposed to that
# plugin as config.<key>; a plugin sees only variables under its own prefix.
# git: an optional GitHub token raises the API rate limit and reaches private
# repositories the token can see.
PLUGIN_GIT_TOKEN=

# ── Tool execution pipeline ───────────────────────────────────────────────────
# Compression caps for the deterministic tool-output pipeline. Raise these if
# tool results arrive over-compressed; lower them if a result floods the
# model's context window.
# Longest text field, in characters, before it is truncated.
PIPELINE_MAX_STRING=1200
# Longest list before it is capped.
PIPELINE_MAX_LIST=25
# Hard ceiling on the JSON tool result handed back to the model.
PIPELINE_INJECT_MAX_CHARS=4000
# Ceiling for a verbatim tool -- one whose output is the point, like a
# workspace file read or a shell capture. Its result skips compression and
# uses this much larger ceiling, so the model sees the file or output whole.
PIPELINE_VERBATIM_MAX_CHARS=200000

# ── Agent file workspace ──────────────────────────────────────────────────────
# The files.* and shell.run agent tools work inside a sandbox: one directory
# per Discord server (per user in a DM), with no way out -- a tool can never
# reach the bot's own files or another server's.
WORKSPACE_ENABLED=true
# Base directory the per-server workspaces live under. Blank puts it at
# .workspace/ beside the bot. The Docker image sets this to /data/workspace,
# so a volume mounted at /data (a Railway volume, or `docker run -v`) keeps
# the workspace across redeploys. Set any absolute path to override.
WORKSPACE_ROOT=
# Caps: the largest single file, the whole workspace, and the file count.
WORKSPACE_MAX_FILE_KB=64
WORKSPACE_QUOTA_KB=4096
WORKSPACE_MAX_FILES=200
# The shell.run tool: an allowlist of read-only commands run inside the
# workspace. Turn it off to keep the file tools without the shell.
WORKSPACE_SHELL_ENABLED=true
# Hard timeout for one shell command, seconds.
WORKSPACE_SHELL_TIMEOUT_S=5

# ── Misc ──────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
